                            //情况一，用a初始化b。第一次调用复制构造函数 \\n \\tcout<<b.getX()<<endl;\\n-\\tfun1(b);                                    //�����������b��Ϊfun1��ʵ�Ρ��ڶ��ε��ø��ƹ��캯�� \\n-\\tb=fun2();                                   //������������ķ���ֵ������󣬺�������ʱ�����ø��ƹ��캯�� \\n+\\tfun1(b);                                    //情况二，对象b作为fun1的实参。第二次调用复制构造函数 \\n+\\tb=fun2();                                   //情况三，函数的返回值是类对象，函数返回时，调用复制构造函数 \\n \\tcout<<b.getX()<<endl;\\n \\treturn 0;\\n } \"\n    },\n    {\n      \"sha\": \"21cbc8309cbc78ff7868c932cf7de0a96bd7f3eb\",\n      \"filename\": \"chapter_04/例4-3 游泳池改造预算 Circle类.cpp\",\n      \"status\": \"modified\",\n      \"additions\": 20,\n      \"deletions\": 20,\n      \"changes\": 40,\n      \"blob_url\": \"https://github.com/bitdove/Cpp_4th/blob/5e607af4491d7a2a78b5b418666a0b420b86d57b/chapter_04%2F%E4%BE%8B4-3%20%E6%B8%B8%E6%B3%B3%E6%B1%A0%E6%94%B9%E9%80%A0%E9%A2%84%E7%AE%97%20Circle%E7%B1%BB.cpp\",\n      \"raw_url\": \"https://github.com/bitdove/Cpp_4th/raw/5e607af4491d7a2a78b5b418666a0b420b86d57b/chapter_04%2F%E4%BE%8B4-3%20%E6%B8%B8%E6%B3%B3%E6%B1%A0%E6%94%B9%E9%80%A0%E9%A2%84%E7%AE%97%20Circle%E7%B1%BB.cpp\",\n      \"contents_url\": \"https://api.github.com/repos/bitdove/Cpp_4th/contents/chapter_04%2F%E4%BE%8B4-3%20%E6%B8%B8%E6%B3%B3%E6%B1%A0%E6%94%B9%E9%80%A0%E9%A2%84%E7%AE%97%20Circle%E7%B1%BB.cpp?ref=5e607af4491d7a2a78b5b418666a0b420b86d57b\",\n      \"patch\": \"@@ -1,49 +1,49 @@\\n #include<iostream>\\n using namespace std;\\n \\n-const float PI=3.141593;                         //����PI��ֵ \\n-const float FENCE_PRICE=35;                      //դ���ĵ��� \\n-const float CONCRETE_PRICE=20;                   //����ˮ�൥�� \\n+const float PI=3.141593;                         //给出PI的值 \\n+const float FENCE_PRICE=35;                      //栅栏的单价 \\n+const float CONCRETE_PRICE=20;                   //过道水泥单价 \\n \\n-class Circle{                                    //����������Circle�������ݺͷ��� \\n-\\tpublic:                                      //�ⲿ�ӿ� \\n-\\t\\tCircle(float r);                         //���캯�� \\n-\\t\\tfloat circumference();                   //����Բ���ܳ� \\n-\\t\\tfloat area();                            //����Բ����� \\n-\\tprivate:                                     //˽�����ݳ�Ա \\n-\\t\\tfloat radius;                            //Բ�İ뾶 \\n+class Circle{                                    //声明定义类Circle及其数据和方法 \\n+\\tpublic:                                      //外部接口 \\n+\\t\\tCircle(float r);                         //构造函数 \\n+\\t\\tfloat circumference();                   //计算圆的周长 \\n+\\t\\tfloat area();                            //计算圆的面积 \\n+\\tprivate:                                     //私有数据成员 \\n+\\t\\tfloat radius;                            //圆的半径 \\n }; \\n \\n \\n-//���ʵ��\\n-//���캯����ʼ�����ݳ�Ա  radius\\n+//类的实现\\n+//构造函数初始化数据成员  radius\\n Circle::Circle(float r){\\n \\tradius=r;\\n } \\n \\n-//����Բ���ܳ�\\n+//计算圆的周长\\n float Circle::circumference(){\\n \\treturn 2*PI*radius;\\n } \\n \\n-//����Բ�����\\n+//计算圆的面积\\n float Circle::area(){\\n \\treturn PI*radius*radius;\\n } \\n \\n-//������ʵ��\\n+//主函数实现\\n int main(){\\n \\tfloat radius;\\n-\\tcout<<\\\"Enter the radius of the pool: \\\";       //��ʾ�û�����뾶 \\n+\\tcout<<\\\"Enter the radius of the pool: \\\";       //提示用户输入半径 \\n \\tcin>>radius;\\n-\\tCircle pool(radius);                          //��Ӿ�ر߽���� \\n-\\tCircle poolRim(radius+3);                     //դ������ \\n+\\tCircle pool(radius);                          //游泳池边界对象 \\n+\\tCircle poolRim(radius+3);                     //栅栏对象 \\n \\t\\n-\\t//����դ��������\\n+\\t//计算栅栏造价输出\\n \\tfloat fenceCost=poolRim.circumference()*FENCE_PRICE;\\n \\tcout<<\\\"Fencing Cost is $\\\"<<fenceCost<<endl;\\n \\t\\n-\\t//�������������\\n+\\t//计算过道造价输出\\n \\tfloat concreteCost=(poolRim.area()-pool.area())*CONCRETE_PRICE;\\n \\tcout<<\\\"Concrete Cost is $\\\"<<concreteCost<<endl;\\n \\t\"\n    },\n    {\n      \"sha\": \"444edec48b4843d186d6ff7633a