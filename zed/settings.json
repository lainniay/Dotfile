{
  "agent_ui_font_size": 18.0,
  "ui_font_family": ".SystemUIFont",
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha",
  },
  "which_key": {
    "enabled": true,
  },
  "disable_ai": true,
  "ssh_connections": [
    {
      "host": "archLain",
      "args": [],
      "projects": [
        {
          "paths": ["/home/lainniay/Code/C/Computer System Base"],
        },
      ],
    },
  ],
  "vim_mode": false,
  "terminal": {
    "font_size": 16.0,
    "cursor_shape": "bar",
  },
  "project_panel": {
    "dock": "left",
    "hide_gitignore": true,
    "scrollbar": {
      "horizontal_scroll": true,
    },
  },
  "base_keymap": "VSCode",
  "preview_tabs": {
    "enable_preview_from_file_finder": true,
  },
  "tab_bar": {
    "show": false,
  },
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": false,
    },
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "buffer_font_fallbacks": ["LXGW WenKai"],
  "buffer_font_family": "Monaspace Xenon",
  "tab_size": 2,
  "ui_font_size": 16,
  "buffer_font_size": 18.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
  "theme_overrides": {
    "Catppuccin Mocha": {
      "editor.background": "#000000",
      "editor.gutter.background": "#000000",
      "terminal.background": "#000000",
      "terminal.ansi.background": "#000000",
      "surface.background": "#000000",
      "elevated_surface.background": "#010101",
      "panel.background": "#010101",
      "panel.overlay_background": "#010101",
      "toolbar.background": "#000000",
      "tab_bar.background": "#000000",
      "tab.active_background": "#000000",
      "tab.inactive_background": "#010101",
      "status_bar.background": "#000000",
      "title_bar.background": "#000000",
